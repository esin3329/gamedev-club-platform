# ============================================================================
# 게임 개발 동아리 플랫폼 환경변수
# 이 파일을 .env.local로 복사하여 사용하세요
# ============================================================================

# Supabase Configuration
# Supabase 프로젝트 생성 후 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (서버 사이드 전용 - 브라우저에 노출 금지!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (OAuth 콜백용)
# 로컬: http://localhost:3000
# 프로덕션: https://your-domain.pages.dev 또는 커스텀 도메인
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# Cloudflare R2 Configuration
# ============================================================================
# Cloudflare Pages 배포 시에는 wrangler.jsonc의 R2 바인딩을 사용합니다.
# 아래 환경변수는 로컬 개발 또는 폴백용입니다.

# Cloudflare 계정 ID (Dashboard URL에서 확인)
R2_ACCOUNT_ID=your-r2-account-id

# R2 API 토큰 (R2 Object Read & Write 권한)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 버킷 이름
R2_BUCKET_NAME=gamedev-builds

# R2 퍼블릭 URL (선택적, 공개 버킷 사용 시)
R2_PUBLIC_URL=

# WebGL 빌드 서빙용 샌드박스 도메인 (보안을 위해 메인 도메인과 분리)
# 예: webgl-builds.your-domain.com
WEBGL_SANDBOX_DOMAIN=webgl.example.com

# ============================================================================
# 빌드 스토리지 설정 (선택적 오버라이드)
# ============================================================================
# 기본값이 적용되며, 필요시 아래 값으로 오버라이드 가능
# 크기 단위: MB는 MiB (1,048,576 bytes = 1024 × 1024)를 의미합니다.

# 업로드 용량 제한 (MiB 단위)
# BUILD_WEBGL_MAX_SIZE_MB=150
# BUILD_PC_MAX_SIZE_MB=500

# zip-bomb 방지: 압축 해제 후 총 크기 제한 (MiB 단위)
# BUILD_WEBGL_MAX_UNCOMPRESSED_MB=500

# zip-bomb 방지: zip 내 최대 파일 수
# BUILD_WEBGL_MAX_FILE_COUNT=1000

# 보관 정책
# BUILD_RETENTION_ENABLED=true
# BUILD_RETENTION_WEBGL_KEEP=2
# BUILD_RETENTION_PC_KEEP=1
# BUILD_RETENTION_KEEP_FEATURED=true

# Presigned URL 만료 시간 (초)
# PRESIGNED_URL_UPLOAD_EXPIRY_SECONDS=3600
# PRESIGNED_URL_DOWNLOAD_EXPIRY_SECONDS=300

# ============================================================================
# Cron Job Security
# ============================================================================
# Cloudflare Workers cron 트리거 보안용 시크릿
# 수동 호출 시 Authorization: Bearer <CRON_SECRET> 헤더 필요
CRON_SECRET=your-random-secret-here

# ============================================================================
# Discord OAuth
# ============================================================================
# Discord Developer Portal에서 OAuth2 앱 생성 후 설정
# Supabase Dashboard > Authentication > Providers > Discord에서 설정
# 콜백 URL: {SUPABASE_URL}/auth/v1/callback

# 참고: Discord Client ID/Secret은 Supabase Dashboard에서 직접 설정합니다.
# 이 파일에는 포함하지 않습니다.
