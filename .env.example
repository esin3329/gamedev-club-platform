# Supabase Configuration
# Supabase 프로젝트 생성 후 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (서버 사이드 전용 - 브라우저에 노출 금지!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Configuration (빌드 파일 저장소)
# Cloudflare 계정 생성 후 R2 버킷 설정에서 확인
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=gamedev-builds
R2_PUBLIC_URL=https://builds.your-domain.com

# WebGL 빌드 서빙용 샌드박스 도메인 (메인 도메인과 분리)
WEBGL_SANDBOX_DOMAIN=https://webgl.your-domain.com

# Site URL (OAuth 콜백용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord OAuth (Supabase Dashboard > Authentication > Providers 에서 설정)
# Discord Developer Portal에서 OAuth2 앱 생성 후 Client ID/Secret을 Supabase에 등록
# 콜백 URL: {SUPABASE_URL}/auth/v1/callback
